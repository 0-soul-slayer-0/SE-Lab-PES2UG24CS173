  <diagram name="Page-1" id="8JFebhU2wJmPNQfIYYx2">
    <mxGraphModel dx="2142" dy="1407" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Database_Query_Performance_Profiler\n\ntitle Database Query Performance Profiler - UML Component Diagram\n\nleft to right direction\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam componentStyle uml\nskinparam packageStyle rectangle\nskinparam linetype ortho\n\nskinparam component {\n    BackgroundColor white\n    BorderColor black\n}\n\n&#39; =========================================================\n&#39; CLIENT\n&#39; =========================================================\n\npackage \&quot;Client Layer\&quot; {\n\n    component \&quot;Dashboard / UI\&quot; as Dashboard\n\n}\n\n&#39; =========================================================\n&#39; BACKEND / MICROSERVICES\n&#39; =========================================================\n\npackage \&quot;Backend / Microservices\&quot; {\n\n    component \&quot;Log Ingestion Service\&quot; as LogIngestion\n\n    component \&quot;Query Analyzer\&quot; as QueryAnalyzer\n\n    component \&quot;Recommendation Engine\&quot; as RecEngine\n\n    component \&quot;Report Generator\&quot; as ReportGen\n\n}\n\n&#39; =========================================================\n&#39; DATA\n&#39; =========================================================\n\npackage \&quot;Data Layer\&quot; {\n\n    database \&quot;Database / Storage\&quot; as DB\n\n}\n\n&#39; =========================================================\n&#39; PROVIDED INTERFACES\n&#39; =========================================================\n\n() \&quot;ILogUpload\&quot; as ILogUpload\n() \&quot;IPerformanceIssues\&quot; as IPerformanceIssues\n() \&quot;IRecommendations\&quot; as IRecommendations\n() \&quot;IWeeklyReport\&quot; as IWeeklyReport\n\n() \&quot;IParsedLogs\&quot; as IParsedLogs\n() \&quot;IOptimizationSuggestions\&quot; as IOptimizationSuggestions\n() \&quot;IWeeklyData\&quot; as IWeeklyData\n() \&quot;IDataAccess\&quot; as IDataAccess\n\n&#39; =========================================================\n&#39; DASHBOARD INTERACTIONS\n&#39; =========================================================\n\nDashboard ..&gt; ILogUpload : &lt;&lt;use&gt;&gt;\nILogUpload - LogIngestion\n\nDashboard ..&gt; IPerformanceIssues : &lt;&lt;use&gt;&gt;\nIPerformanceIssues - QueryAnalyzer\n\nDashboard ..&gt; IRecommendations : &lt;&lt;use&gt;&gt;\nIRecommendations - RecEngine\n\nDashboard ..&gt; IWeeklyReport : &lt;&lt;use&gt;&gt;\nIWeeklyReport - ReportGen\n\n&#39; =========================================================\n&#39; MICROSERVICE PIPELINE\n&#39; =========================================================\n\nLogIngestion ..&gt; IParsedLogs : &lt;&lt;use&gt;&gt;\nIParsedLogs - QueryAnalyzer\n\nQueryAnalyzer ..&gt; IOptimizationSuggestions : &lt;&lt;use&gt;&gt;\nIOptimizationSuggestions - RecEngine\n\nRecEngine ..&gt; IWeeklyData : &lt;&lt;use&gt;&gt;\nIWeeklyData - ReportGen\n\n&#39; =========================================================\n&#39; DATABASE ACCESS\n&#39; =========================================================\n\nQueryAnalyzer ..&gt; IDataAccess : &lt;&lt;use&gt;&gt;\nRecEngine ..&gt; IDataAccess : &lt;&lt;use&gt;&gt;\n\nIDataAccess - DB\n\n&#39; =========================================================\n&#39; NOTES\n&#39; =========================================================\n\nnote bottom of LogIngestion\nHandles up to\n5,000 log records/minute\nend note\n\nnote bottom of QueryAnalyzer\nDetects slow queries\nand performance issues\nend note\n\nnote bottom of RecEngine\nGenerates optimization\nrecommendations\nend note\n\nnote bottom of ReportGen\nGenerates weekly\nperformance reports\nend note\n\nnote bottom of DB\nStores logs, performance issues,\nrecommendations and weekly reports\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QLS_ydfz1tIKAnKOYbiC-318">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
